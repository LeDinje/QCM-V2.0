// Règles de sécurité Firestore — QCM Pôle Sud v2
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // QCM et questions : lisibles par tous (les candidats doivent les voir), écriture réservée aux admins.
    // Les questions ne contiennent PAS la bonne réponse (voir answerKeys).
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Bonnes réponses : un document par QCM { keys: { questionId: index } }, réservé aux admins.
    match /answerKeys/{quizId} {
      allow read, write: if isAdmin();
    }

    // Résultats : un candidat (même anonyme) crée son propre résultat, sans pouvoir fixer de score
    // (le score est calculé côté admin à partir de answerKeys). Lecture / modification / suppression : admins.
    function isV2Result(d) {
      return d.v == 2
        && !d.keys().hasAny(['score', 'answersDetails'])
        && d.candidateName is string
        && d.candidateName.size() > 0
        && d.candidateName.size() <= 100
        && d.quizId is string;
    }
    // PHASE D'APERÇU : l'ancien site (v1) est encore en ligne et envoie des résultats avec un score.
    // Une fois la v2 mise en production, SUPPRIMER cette fonction et « || isLegacyResult(...) » ci-dessous.
    function isLegacyResult(d) {
      return !d.keys().hasAny(['v']);
    }
    match /results/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (isV2Result(request.resource.data) || isLegacyResult(request.resource.data));
      allow read, update, delete: if isAdmin();
    }

    // Admins : la présence d'un document = administrateur. Gestion uniquement depuis la console Firebase.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
  }
}
