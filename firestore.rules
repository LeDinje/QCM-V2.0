// Règles de sécurité Firestore — QCM Pôle Sud v2
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    // Admin actif : un document admins/{uid} existe et n'est pas désactivé.
    function isAdmin() {
      return isSignedIn() && exists(adminDoc()) && get(adminDoc()).data.get('disabled', false) != true;
    }

    // Super admin : admin actif avec role == 'superadmin' (gère les comptes admin).
    function isSuperAdmin() {
      return isAdmin() && get(adminDoc()).data.get('role', 'admin') == 'superadmin';
    }

    // QCM et questions : lisibles par tous (les candidats doivent les voir), écriture réservée aux admins.
    // Les questions ne contiennent PAS la bonne réponse (voir answerKeys).
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Bonnes réponses : un document par QCM { keys: { questionId: index } }, réservé aux admins.
    match /answerKeys/{quizId} {
      allow read, write: if isAdmin();
    }

    // Résultats : un candidat (même anonyme) crée son propre résultat, sans pouvoir fixer de score
    // (le score est calculé côté admin à partir de answerKeys). Lecture / modification / suppression : admins.
    function isV2Result(d) {
      return d.v == 2
        && !d.keys().hasAny(['score', 'answersDetails'])
        && d.candidateName is string
        && d.candidateName.size() > 0
        && d.candidateName.size() <= 100
        && d.quizId is string;
    }
    match /results/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isV2Result(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Checklists d'intégration technicien (page cachée /integration).
    // L'identifiant du document EST le lien personnel (aléatoire, 36 caractères) : le connaître suffit pour lire
    // et compléter SA checklist. Personne d'autre qu'un super admin ne peut lister les checklists ni en supprimer.
    function validChecklistCreate(d) {
      return d.keys().hasOnly(['techName', 'startDate', 'referent', 'items', 'notes', 'sectionUpdatedAt', 'createdAt', 'updatedAt'])
        && d.techName is string && d.techName.size() > 0 && d.techName.size() <= 100
        && d.startDate is string && d.startDate.size() <= 20
        && d.referent is string && d.referent.size() <= 100
        && d.items is map && d.items.size() == 0
        && d.notes is map && d.notes.size() == 0;
    }
    match /integration_checklists/{checklistId} {
      allow get: if isSignedIn();
      allow list, delete: if isSuperAdmin();
      allow create: if isSignedIn() && checklistId.size() >= 32 && validChecklistCreate(request.resource.data);
      // le technicien ne modifie que ses réponses et ses remarques (nom, date et référent sont figés)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'notes', 'sectionUpdatedAt', 'updatedAt'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 300
        && request.resource.data.notes is map && request.resource.data.notes.size() <= 50;
    }

    // Contenu de la checklist d'intégration (sections + sujets) : lu par la page technicien, modifié par les super admins.
    match /integration_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() && configId == 'current'
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && request.resource.data.sections.size() <= 50;
    }

    // Admins : un document par compte admin { email, role: 'admin' | 'superadmin', disabled, createdAt, createdBy, lastLoginAt }.
    // - chacun lit son propre document et peut y mettre à jour son e-mail et sa date de dernière connexion ;
    // - un super admin gère les autres comptes, mais jamais le sien (impossible de se retirer ses propres droits) ;
    // - le tout premier super admin se désigne depuis la console Firebase (champ role = "superadmin").
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email;
      allow create, update: if isSuperAdmin() && request.auth.uid != uid
        && request.resource.data.role in ['admin', 'superadmin']
        && request.resource.data.email is string;
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }
  }
}
