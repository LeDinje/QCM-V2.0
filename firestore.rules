// Règles de sécurité Firestore — QCM Pôle Sud v2
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // QCM et questions : lisibles par tous (les candidats doivent les voir), écriture réservée aux admins.
    // Les questions ne contiennent PAS la bonne réponse (voir answerKeys).
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Bonnes réponses : un document par QCM { keys: { questionId: index } }, réservé aux admins.
    match /answerKeys/{quizId} {
      allow read, write: if isAdmin();
    }

    // Résultats : un candidat (même anonyme) crée son propre résultat, sans pouvoir fixer de score
    // (le score est calculé côté admin à partir de answerKeys). Lecture / modification / suppression : admins.
    match /results/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.v == 2
        && !request.resource.data.keys().hasAny(['score', 'answersDetails'])
        && request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() > 0
        && request.resource.data.candidateName.size() <= 100
        && request.resource.data.quizId is string;
      allow read, update, delete: if isAdmin();
    }

    // Admins : la présence d'un document = administrateur. Gestion uniquement depuis la console Firebase.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
  }
}
